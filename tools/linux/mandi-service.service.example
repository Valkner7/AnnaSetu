# systemd unit that keeps the price service running and starts it at boot.
# Copy to /etc/systemd/system/mandi-service.service, fix the three paths/user below, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mandi-service
[Unit]
Description=AnnaSetu Mandi Setu price service
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/AnnaSetu/ai/mandi_service
# Slim mode: only what AnnaSetu uses (needs only requirements-slim.txt). MANDI_SLIM=0 in the file below turns it off.
Environment=MANDI_SLIM=1
EnvironmentFile=-/var/www/AnnaSetu/config/mandi-service.env
ExecStart=/var/www/AnnaSetu/ai/mandi_service/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
